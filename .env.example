# Copy this file to .env, then replace every placeholder locally.
# .env is ignored by Git. Never commit or share it.

# CognoDB Cloud (Bolt)
COGNODB_URI=bolt+s://YOUR-COGNODB-HOST
COGNODB_USER=YOUR_COGNODB_DATABASE_USER
COGNODB_PASS=YOUR_COGNODB_DATABASE_PASSWORD

# Neo4j AuraDB: download the credentials file from the Aura instance page.
NEO4J_URI=neo4j+s://YOUR-NEO4J-HOST
NEO4J_USER=neo4j
NEO4J_PASS=YOUR_NEO4J_DATABASE_PASSWORD

# Memgraph Cloud with SSL enabled
MEMGRAPH_URI=bolt+ssc://YOUR-MEMGRAPH-HOST:7687
MEMGRAPH_USER=YOUR_MEMGRAPH_DATABASE_USER
MEMGRAPH_PASS=YOUR_MEMGRAPH_DATABASE_PASSWORD

# FalkorDB. Use redis:// or rediss:// because the harness uses redis-py.
FALKORDB_URI=redis://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT

# Optional sixth target: Dgraph
DGRAPH_URI=https://YOUR-DGRAPH-HOST:8080

# Fourth comparison target: TigerGraph Cloud
TIGERGRAPH_URI=https://YOUR-TIGERGRAPH-DOMAIN.i.tgcloud.io
TIGERGRAPH_TOKEN=YOUR_SHORT_LIVED_RESTPP_TOKEN
